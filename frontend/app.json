{
  "expo": {
    "name": "Owami",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "owami",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.cookistmode.iqg675"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#2D1E19"
      },
      "package": "com.emergent.cookistmode.iqg675"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 320,
          "resizeMode": "contain",
          "backgroundColor": "#2D1E19"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Owami to use your microphone.",
          "speechRecognitionPermission": "Allow Owami to recognize your speech."
        }
      ],
      "@react-native-vector-icons/material-design-icons",
      [
        "expo-image-picker",
        {
          "photosPermission": "Add a photo to your recipes.",
          "cameraPermission": "Take a photo of the dish you cooked."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
